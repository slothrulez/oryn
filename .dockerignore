# trim the build context: node_modules/.next/data are generated by the build stage, and the host's
# mac-arm64 native modules or dev data (including real projects) must never be baked into the image.
node_modules
.next
data
release
.git
.github
*.log
.DS_Store
.env
.env.*
Dockerfile
.dockerignore
*.dmg
*.exe
electron/dist
coverage
.vscode
.idea

# Local work records
/task_plan.md
/findings.md
/progress.md
